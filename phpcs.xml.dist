<?xml version="1.0"?>
<ruleset name="Rytköset Theme">
	<description>WordPress Coding Standards Rytkösten sukuseuran teemalle.</description>

	<!-- Tarkistuskohteet: teema ja erilliset operatiiviset wp-content-tiedostot. -->
	<file>wp-content/themes/rytkoset-theme</file>
	<file>wp-content/maintenance.php</file>
	<file>wp-content/mu-plugins</file>

	<!-- Vain PHP-tiedostot. -->
	<arg name="extensions" value="php"/>

	<!-- Näytä sniff-koodit (s) ja edistyminen (p), värit päälle. -->
	<arg value="ps"/>
	<arg name="colors"/>

	<!-- Vendoroidut kirjastot ovat kolmannen osapuolen koodia. -->
	<exclude-pattern>*/assets/vendor/*</exclude-pattern>

	<!-- WordPressin ydintyyli ja tietoturvatarkistukset. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress.Security"/>

	<!-- Teeman tekstidomain i18n-tarkistuksiin. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="rytkoset-theme"/>
			</property>
		</properties>
	</rule>

	<!-- Projektin globaali prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="rytkoset_theme"/>
				<element value="rytkoset"/>
			</property>
		</properties>
	</rule>

	<!-- bbPress and WooCommerce template overrides must invoke the plugin's public hooks verbatim. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>*/bbpress/*</exclude-pattern>
		<exclude-pattern>*/woocommerce/*</exclude-pattern>
	</rule>

	<!-- CPT slugs contain underscores, as required by WordPress template hierarchy. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/archive-digital_magazine.php</exclude-pattern>
		<exclude-pattern>*/archive-gallery_album.php</exclude-pattern>
		<exclude-pattern>*/archive-rytkoset_event.php</exclude-pattern>
		<exclude-pattern>*/single-digital_magazine.php</exclude-pattern>
		<exclude-pattern>*/single-gallery_album.php</exclude-pattern>
		<exclude-pattern>*/single-rytkoset_event.php</exclude-pattern>
	</rule>

	<!-- Tuettu WordPress-minimiversio deprekaatiotarkistuksiin. -->
	<config name="minimum_wp_version" value="6.0"/>
</ruleset>
